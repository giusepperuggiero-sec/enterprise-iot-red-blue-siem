#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

// Copy this file to "arduino_secrets.h" in the same folder and fill in your local network values.
// Never commit "arduino_secrets.h" to version control.

#define SECRET_SSID "YOUR_WIFI_SSID"
#define SECRET_PASS "YOUR_WIFI_PASSWORD"

// Static IPv4 configuration (comma-separated octets for IPAddress)
#define SECRET_LOCAL_IP   192, 168, 137, 197
#define SECRET_GATEWAY    192, 168, 137, 1
#define SECRET_SUBNET     255, 255, 255, 0
#define SECRET_DNS        8, 8, 8, 8

// Wazuh SIEM / Syslog collector destination
#define SECRET_WAZUH_IP   "192.168.137.240"
#define SECRET_SYSLOG_PORT 514

#endif

